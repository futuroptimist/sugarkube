    {
      "id": 20,
      "type": "timeseries",
      "title": "TLS certificate lifetime",
      "description": "Days until the earliest certificate expiry.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 51
      },
      "targets": [
