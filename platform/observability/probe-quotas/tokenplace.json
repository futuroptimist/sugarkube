{
  "schemaVersion": 1,
  "application": "tokenplace",
  "probes": [
    {
      "application": "tokenplace",
      "environment": "staging",
      "probe": "blackbox-tokenplace-staging-root",
      "route": "root",
      "path": "/",
      "method": "GET",
      "interval": "60s",
      "enabled": true,
      "bucket": "public-api",
      "limits": {
        "hourly": 60,
        "daily": 1000
      },
      "exemptions": [
        {
          "path": "/",
          "methods": [
            "GET",
            "HEAD"
          ]
        }
      ],
      "fanout": 1,
      "requestMultiplier": 1,
      "safetyMargin": 0.2,
      "unlimited": false
    },
    {
