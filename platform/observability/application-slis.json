    },
    {
      "id": "dspace-request-success", "application": "DSPACE", "userJourney": "Complete an eligible DSPACE HTTP request", "signalType": "actual_request_success",
      "dataSource": "dspace_http_requests_total", "numerator": "increase of eligible non-5xx requests across all replicas", "denominator": "increase of all eligible requests across all replicas", "exclusions": ["/metrics", "/healthz", "/livez", "/health", "counter-reset or incomplete windows"], "observationWindow": "24h", "monitoring": "configured", "represents": "actual instrumented requests"
