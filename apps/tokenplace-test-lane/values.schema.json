{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId"],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
      "description": "Unique experiment label, never a credential or caller identity"
    }
  }
}
